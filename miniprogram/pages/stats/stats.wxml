<view class="stats-page">
  <view class="checkin-block">
    <view class="checkin-head">
      <text class="block-title">每日打卡</text>
      <text class="checkin-today {{checkedToday ? 'on' : ''}}">
        {{checkedToday ? '今日已打卡' : '今日未打卡'}}
      </text>
    </view>
    <view class="checkin-grid">
      <view class="summary-item">
        <text class="item-num">{{checkinStreak}}</text>
        <text class="item-label">连续天数</text>
      </view>
      <view class="summary-item">
        <text class="item-num">{{checkinDays}}</text>
        <text class="item-label">累计打卡</text>
      </view>
    </view>

    <view class="cal-nav">
      <text class="cal-nav-btn" bindtap="onPrevMonth">上一月</text>
      <text class="cal-label">{{calendarLabel}}</text>
      <text class="cal-nav-btn" bindtap="onNextMonth">下一月</text>
    </view>

    <view class="cal-week">
      <text wx:for="{{weekLabels}}" wx:key="*this" class="cal-week-cell">{{item}}</text>
    </view>
    <view class="cal-grid">
      <view
        wx:for="{{calendarCells}}"
        wx:for-index="cidx"
        wx:key="cidx"
        class="cal-cell {{item.empty ? 'empty' : ''}} {{item.checked ? 'checked' : ''}} {{item.isToday ? 'today' : ''}}"
      >
        <text wx:if="{{!item.empty}}">{{item.day}}</text>
      </view>
    </view>

    <view class="recent" wx:if="{{recentCheckins.length}}">
      <text class="recent-title">最近记录</text>
      <view class="recent-row" wx:for="{{recentCheckins}}" wx:key="date">
        <text class="recent-date">{{item.date}}</text>
        <text class="recent-stat">答 {{item.answered}} · 对 {{item.correct}}</text>
      </view>
    </view>
  </view>

  <view class="summary">
    <text class="summary-label">累计正确率</text>
    <view class="summary-rate">
      <text class="rate-num">{{accuracy}}</text>
      <text class="rate-unit">%</text>
    </view>
    <view class="summary-grid">
      <view class="summary-item">
        <text class="item-num">{{total}}</text>
        <text class="item-label">已答</text>
      </view>
      <view class="summary-item">
        <text class="item-num">{{correct}}</text>
        <text class="item-label">正确</text>
      </view>
      <view class="summary-item">
        <text class="item-num">{{wrong}}</text>
        <text class="item-label">错误</text>
      </view>
    </view>
  </view>

  <view class="block" wx:if="{{categoryRows.length}}">
    <text class="block-title">分类正确率</text>
    <view class="cat-list">
      <view class="cat-row" wx:for="{{categoryRows}}" wx:key="name">
        <text class="cat-name">{{item.name}}</text>
        <view class="cat-bar-wrap">
          <view class="cat-bar" style="width: {{item.accuracy}}%;"></view>
        </view>
        <text class="cat-pct">{{item.accuracy}}%</text>
        <text class="cat-count">{{item.correct}}/{{item.total}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!hasData && !checkinDays}}">
    <text class="empty-title">还没有答题记录</text>
    <text class="empty-desc">答一题即可完成今日打卡</text>
    <button class="btn-primary empty-cta" bindtap="goQuiz">开始答题</button>
  </view>

  <view class="actions">
    <button class="btn-ghost" bindtap="goQuiz">{{hasData ? '继续答题' : '开始答题'}}</button>
    <button class="btn-text clear-btn" wx:if="{{hasData}}" bindtap="onClear">清空成绩</button>
  </view>
</view>
