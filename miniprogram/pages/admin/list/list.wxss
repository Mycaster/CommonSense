.admin-page {
  min-height: 100vh;
  padding: 32rpx 40rpx 100rpx;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 28rpx;
}

.tool-btn {
  height: 80rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  letter-spacing: 0.08em;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.filter-chip {
  font-size: 24rpx;
  color: var(--ink-muted);
  letter-spacing: 0.08em;
  padding: 8rpx 4rpx;
  border-bottom: 2rpx solid transparent;
}

.filter-chip.active {
  color: var(--teal);
  border-bottom-color: var(--teal);
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-size: 24rpx;
  color: var(--ink-muted);
}

.meta-actions {
  display: flex;
  gap: 8rpx;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: var(--ink-muted);
}

.q-item {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.q-main {
  flex: 1;
  min-width: 0;
}

.q-top {
  display: flex;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.q-cat {
  font-size: 22rpx;
  color: var(--teal);
  letter-spacing: 0.1em;
}

.q-status {
  font-size: 20rpx;
  color: var(--ink-muted);
}

.status-published {
  color: var(--teal);
}

.status-draft {
  color: #9a7b4f;
}

.status-archived {
  color: var(--wrong);
}

.q-title {
  display: block;
  font-size: 28rpx;
  color: var(--ink);
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.q-id {
  font-size: 20rpx;
  color: var(--ink-muted);
}

.archive-btn {
  align-self: center;
  height: 64rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.empty {
  padding: 80rpx 24rpx;
  text-align: center;
  color: var(--ink-muted);
  font-size: 26rpx;
}

.openid-hint {
  margin-top: 64rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--line);
}

.openid-hint text {
  display: block;
  font-size: 22rpx;
  color: var(--ink-muted);
}

.openid-val {
  margin-top: 8rpx;
  word-break: break-all;
  color: var(--ink-soft) !important;
}
