.edit-page {
  min-height: 100vh;
  padding: 32rpx 40rpx 100rpx;
}

.field {
  margin-bottom: 36rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--ink-muted);
  letter-spacing: 0.08em;
  margin-bottom: 12rpx;
}

.input,
.picker-val {
  width: 100%;
  min-height: 80rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 28rpx;
  color: var(--ink);
  box-sizing: border-box;
}

.option-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.opt-key {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--line);
  border-radius: 8rpx;
  font-size: 26rpx;
  color: var(--ink-muted);
  flex-shrink: 0;
}

.opt-key.active {
  background: var(--teal);
  border-color: var(--teal);
  color: #fff;
  font-weight: 600;
}

.opt-input {
  flex: 1;
}

.status-row {
  display: flex;
  gap: 24rpx;
}

.status-chip {
  font-size: 26rpx;
  color: var(--ink-muted);
  padding: 8rpx 4rpx;
  border-bottom: 2rpx solid transparent;
}

.status-chip.active {
  color: var(--teal);
  border-bottom-color: var(--teal);
}

.save-btn {
  width: 100%;
  margin-top: 24rpx;
}

.delete-btn {
  margin-top: 24rpx;
  color: var(--wrong) !important;
}
